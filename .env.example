# Fanta-OFME-Cloud Configuration
FANTA_SERVER_NAME=Fanta-OFME-Cloud
FANTA_PORT=8080

# Optional Master API Key (if set, clients must provide this key or a key created in the Web Dashboard)
FANTA_API_KEY=

# Optional Web Dashboard Admin Password (leave blank for open local dashboard access)
FANTA_ADMIN_PASSWORD=

# Require API Key authentication even if no keys are set via env
FANTA_REQUIRE_AUTH=false

# Number of rolling backup versions to preserve per game
FANTA_MAX_HISTORY=5

# Maximum save archive upload size in MB
FANTA_MAX_UPLOAD_MB=512

